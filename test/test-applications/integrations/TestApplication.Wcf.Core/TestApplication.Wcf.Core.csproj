<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="CoreWCF.Http" VersionOverride="$(LibraryVersion)" />
    <PackageReference Include="CoreWCF.NetTcp" VersionOverride="$(LibraryVersion)" />
    <PackageReference Include="CoreWCF.Primitives" VersionOverride="$(LibraryVersion)" />
    <!-- Override vulnerable cryptography inherited from the older server versions. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
</Project>
