<Project>
  <!-- Product tags must not change the native/managed upstream assembly identity. -->
  <PropertyGroup>
    <BeaconUpstreamDevelopmentVersion>1.20.0</BeaconUpstreamDevelopmentVersion>
    <BeaconProductVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.properties').Trim().Replace('beacon.version=', ''))</BeaconProductVersion>
    <MinVerVersionOverride>$(BeaconUpstreamDevelopmentVersion)-beacon.$(BeaconProductVersion)</MinVerVersionOverride>
  </PropertyGroup>
</Project>
